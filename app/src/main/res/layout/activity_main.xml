<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/room_bg"
    tools:context=".MainActivity">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  STAND — first child = lowest z-order, behind everything -->
    <!--  @+id/ forward-references are intentional: ConstraintLayout  -->
    <!--  resolves all IDs before laying out, so order doesn't matter -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <com.example.luckydraw.StandView
        android:id="@+id/standViewBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toTopOf="@+id/playTV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/wheelTV" />

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  HUD: declared second so room items can reference them  -->
    <!--  elevation=4dp keeps them rendered above the overlay   -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- Status bar — always readable, floats above dim overlay via elevation -->
    <TextView
        android:id="@+id/statusTV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#CC000000"
        android:elevation="4dp"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/status_no_power"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  ROOM LAYER — dimmed when unpowered                    -->
    <!--  All items below dimOverlay in z-order (elevation=0)   -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- Lucky draw wheel — center of the store room -->
    <com.example.luckydraw.WheelView
        android:id="@+id/wheelTV"
        android:layout_width="210dp"
        android:layout_height="210dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.36" />

    <!-- POINTER: Anchor — custom AnchorView, red/! when unstable, green/✓ when stable -->
    <com.example.luckydraw.AnchorView
        android:id="@+id/anchorTV"
        android:layout_width="56dp"
        android:layout_height="48dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toTopOf="@id/wheelTV"
        app:layout_constraintEnd_toEndOf="@id/wheelTV"
        app:layout_constraintStart_toStartOf="@id/wheelTV" />

    <!-- ITEM: Stand bolt — the StandView itself is now the tappable stand control -->
    <!-- (standTV Button removed: the bolt drawn on StandView communicates state visually) -->

    <!-- ITEM: Power cable — bottom-left corner of room, drawn as a plug/socket -->
    <com.example.luckydraw.CableView
        android:id="@+id/cableTV"
        android:layout_width="120dp"
        android:layout_height="80dp"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toTopOf="@id/playTV"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Start button — bottom center, glows amber when powered -->
    <Button
        android:id="@+id/playTV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="28dp"
        android:minHeight="52dp"
        android:onClick="play"
        android:text="@string/start_button"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  DIM OVERLAY — elevation=0, comes after room items     -->
    <!--  so it renders above them in z-order but BELOW the     -->
    <!--  elevated HUD views (statusTV, luckyNumberTV)          -->
    <!--  clickable=false → all touches pass through            -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.72"
        android:background="#000000"
        android:clickable="false"
        android:elevation="0dp"
        android:focusable="false"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>